{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@branching/shared": ["shared/src/index.ts"],
      "@branching/shared/*": ["shared/src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["shared/src/**/*.ts", "client/web/src/**/*.ts", "client/web/src/**/*.tsx", "server/src/**/*.ts"]
}
