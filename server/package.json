{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "jobs:worker": "tsx src/jobs/runWorker.ts",
    "test": "yarn run -T test:unit server/src",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:status": "tsx src/db/migrate.ts status",
    "db:seed": "tsx src/db/seed.ts --dev",
    "db:reset": "tsx src/db/reset.ts --dev",
    "db:init": "yarn db:migrate",
    "db:status": "tsx src/db/migrate.ts status"
  },
  "dependencies": {
    "@branching/shared": "workspace:*",
    "@trpc/server": "latest",
    "cors": "latest",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "pg": "^8.16.2",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/pg": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3"
  }
}
