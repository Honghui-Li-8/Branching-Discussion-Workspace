DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bdw # Main application database.
DATABASE_URL_DEV=postgresql://postgres:postgres@localhost:5432/bdw_dev # Development seed/reset database.
DB_ENV=dev # Selects dev database for scripts that support DB_ENV=dev.
DEV_AUTH_TOKEN=local-dev-token # Local backend dev login token.
SUPABASE_URL=https://example.supabase.co # Supabase project URL for token verification.
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key # Server-only Supabase service-role secret.
OPENAI_API_KEY=local-openai-api-key # Required for GPT-backed assistant turns.
SERVER_LOG_LEVEL=info # Minimum log level: debug, info, warn, or error.
