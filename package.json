{
  "name": "branching-discussion-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "client/web",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "yarn workspace web dev",
    "dev:server": "yarn workspace server dev",
    "build": "yarn workspace web build",
    "test": "bash ./scripts/test-all.sh",
    "test:all": "bash ./scripts/test-all.sh",
    "test:unit": "jest --config jest.config.cjs --watchman=false",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "check:ownership-boundary": "yarn test:unit --runInBand server/src/ownershipImportBoundary.test.ts",
    "spellcheck": "cspell lint --config cspell.json",
    "db:init": "yarn workspace server db:migrate",
    "db:seed": "yarn workspace server db:seed",
    "db:reset": "yarn workspace server db:reset",
    "lint": "yarn workspace web lint",
    "check:type": "bash ./scripts/typecheck.sh",
    "preview": "yarn workspace web preview",
    "server": "yarn workspace server start"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/jest": "^30.0.0",
    "cspell": "^9.7.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
